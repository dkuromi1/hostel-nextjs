{
  "name": "scodrinon-nextjs",
  "version": "1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prebuild && next dev",
    "prebuild": "node scripts/prebuild.js",
    "create-instance": "node scripts/create-instance.js",
    "validate-instance": "node scripts/validate-instance.js",
    "validate-instances": "node scripts/validate-instance.js --all",
    "validate-templates": "node scripts/validate-instance.js --templates --all",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@serwist/next": "^9.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^3.24.0",
    "next": "16.2.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.9",
    "@opennextjs/cloudflare": "^1.8.0",
    "@serwist/cli": "^9.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "serwist": "^9.5.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "wrangler": "^4.14.4"
  },
  "browserslist": [
    "> 0.5%",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=24"
  }
}
